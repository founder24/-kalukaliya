# Local DO env exports — pulled from Railway via `railway variables list`
# and imported into App Platform via `scripts/do.sh import-env`.
# Never commit plaintext secrets; the encrypted values live in App
# Platform and the encrypted GitHub environment secrets.
do-backend-vars.env
do-rust-vars.env

# Vite build output. `pnpm --filter @workspace/syrabit run build`
# emits to both `dist/` (client bundle) and `dist-ssr/` (SSR bundle).
# Both are regenerable and must never be committed.
#   - Task #87: an earlier deploy run accidentally committed 160 files
#     under dist-ssr/, breaking the canonical-delegation guard on
#     minified vendor strings inside the bundles.
#   - Task #90: removed those 160 files from main and added
#     `_check_no_tracked_dist_files` to the canonical-delegation guard
#     so any future `git add -f artifacts/syrabit/dist*/` lands as a
#     CI failure instead of slipping through this gitignore.
# Keep these entries forever.
dist-ssr/
dist/
