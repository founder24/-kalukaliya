      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "530687470",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"EnqueueAndAdminListing\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"sqs:SendMessageBatch\",\n        \"sqs:SendMessage\",\n        \"sqs:ReceiveMessage\",\n        \"sqs:GetQueueUrl\",\n        \"sqs:GetQueueAttributes\",\n        \"sqs:DeleteMessage\"\n      ],\n      \"Resource\": [\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-unified-logs-pull-dlq\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-unified-logs-pull\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-seo-internal-linker-dlq\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-seo-internal-linker\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-seo-indexnow-dlq\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-seo-indexnow\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-email-fallback-dlq\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-email-fallback\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-discovery-ingest-dlq\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-discovery-ingest\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-cf-bot-crosscheck-dlq\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-cf-bot-crosscheck\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-bing-submit-dlq\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-bing-submit\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-bing-keyword-dlq\",\n        \"arn:aws:sqs:ap-south-1:271740379017:syrabit-bing-keyword\"\n      ]\n    },\n    {\n      \"Sid\": \"ReadCloudWatchForAdminCard\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"cloudwatch:GetMetricStatistics\",\n        \"cloudwatch:GetMetricData\",\n        \"cloudwatch:DescribeAlarms\"\n      ],\n      \"Resource\": \"*\"\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"EnqueueAndAdminListing\",\"Effect\":\"Allow\",\"Action\":[\"sqs:SendMessageBatch\",\"sqs:SendMessage\",\"sqs:ReceiveMessage\",\"sqs:GetQueueUrl\",\"sqs:GetQueueAttributes\",\"sqs:DeleteMessage\"],\"Resource\":[\"arn:aws:sqs:ap-south-1:271740379017:syrabit-unified-logs-pull-dlq\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-unified-logs-pull\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-seo-internal-linker-dlq\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-seo-internal-linker\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-seo-indexnow-dlq\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-seo-indexnow\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-email-fallback-dlq\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-email-fallback\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-discovery-ingest-dlq\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-discovery-ingest\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-cf-bot-crosscheck-dlq\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-cf-bot-crosscheck\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-bing-submit-dlq\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-bing-submit\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-bing-keyword-dlq\",\"arn:aws:sqs:ap-south-1:271740379017:syrabit-bing-keyword\"]},{\"Sid\":\"ReadCloudWatchForAdminCard\",\"Effect\":\"Allow\",\"Action\":[\"cloudwatch:GetMetricStatistics\",\"cloudwatch:GetMetricData\",\"cloudwatch:DescribeAlarms\"],\"Resource\":\"*\"}]}",
            "override_json": null,
            "override_policy_documents": null,
            "policy_id": null,
            "source_json": null,
            "source_policy_documents": null,
            "statement": [
              {
