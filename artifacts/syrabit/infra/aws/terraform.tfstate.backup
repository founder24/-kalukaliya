            "id": "125098489",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"AllowCloudWatchAlarms\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"SNS:Publish\",\n      \"Resource\": \"arn:aws:sns:ap-south-1:271740379017:syrabit-ops-alerts\",\n      \"Principal\": {\n        \"Service\": \"cloudwatch.amazonaws.com\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"AWS:SourceAccount\": \"271740379017\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"AllowBudgetsAndCostAnomaly\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"SNS:Publish\",\n      \"Resource\": \"arn:aws:sns:ap-south-1:271740379017:syrabit-ops-alerts\",\n      \"Principal\": {\n        \"Service\": [\n          \"costalerts.amazonaws.com\",\n          \"budgets.amazonaws.com\"\n        ]\n      }\n    }\n  ]\n}",
