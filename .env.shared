# ==========================================
# SYRABIT.AI - MASTER ENVIRONMENT TEMPLATE (v3.1)
# Copy this to .env and fill in your secrets
# DO NOT COMMIT .env TO GIT
# ==========================================

# ------------------------------------------
# P1: CLOUDFLARE (Edge Shield)
# ------------------------------------------
CF_ACCOUNT_ID=acct_xxx
CF_API_TOKEN=token_xxx
CF_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
CF_R2_BUCKET=syrabit-assets
CF_R2_ACCESS_KEY=xxx
CF_R2_SECRET_KEY=xxx
CF_WORKER_URL=https://edge.syrabit.ai
# Cloudflare Workers AI model name for LLM inference
CF_AI_MODEL=@cf/meta/llama-3.1-70b-instruct

# ------------------------------------------
# P1b: CLOUDFLARE KV (Content Edge Cache)
# ------------------------------------------
# API token for accessing Cloudflare KV from backend
CLOUDFLARE_KV_API_TOKEN=token_xxx
# Cloudflare account ID for KV API calls (separate from CF_ACCOUNT_ID used by wrangler)
CLOUDFLARE_ACCOUNT_ID=acct_xxx
# KV namespace ID for content cache
CLOUDFLARE_KV_NAMESPACE_ID=ns_xxx

# ------------------------------------------
# P1c: EDGE WORKER BINDINGS (Cloudflare Workers env)
# ------------------------------------------
# Allowed origin for CORS in the edge worker
ALLOWED_ORIGIN=https://syrabit.ai
# Backend URL the edge worker proxies to
# Uses BACKEND_URL defined in the Cloud Run section below
# KV namespace binding for ISR (Incremental Static Regeneration) cache
ISR_CACHE_KV=isr-cache-kv-binding
# R2 bucket binding for static assets
R2_BUCKET=syrabit-assets
# KV namespace binding for rate limiting
RATE_LIMIT_KV=rate-limit-kv-binding

# ------------------------------------------
# P2: GOOGLE CLOUD RUN (Backend Orchestrator)
# ------------------------------------------
BACKEND_URL=https://syrabit-backend-xxxxx.run.app
GCP_PROJECT_ID=blissful-acumen-495019-t6
GCP_REGION=asia-south1

# ------------------------------------------
# P4: MONGODB (State Store)
# ------------------------------------------
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/syrabit?retryWrites=true&w=majority
MONGODB_DB_NAME=syrabit_prod
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# ------------------------------------------
# P5: UPSTASH (Gatekeeper)
# ------------------------------------------
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=token_xxx
RATE_LIMIT_FREE_TIER=30
RATE_LIMIT_PRO_TIER=999999

# ------------------------------------------
# P6: VERTEX AI (English Brain + Search)
# ------------------------------------------
VERTEX_PROJECT_ID=blissful-acumen-495019-t6
VERTEX_SEARCH_DATASTORE_ID=syrabit-edu-datastore
VERTEX_SEARCH_SERVING_CONFIG=default_search
VERTEX_SEARCH_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-2.0-flash-lite
VERTEX_LOCATION=asia-south1
VERTEX_VISION_MODEL=gemini-2.0-flash-lite
# Option 1: File path (local dev) - point to the key file
GOOGLE_APPLICATION_CREDENTIALS=~/.secrets/sa-key-blissful-acumen-495019-t6.json
# Option 2: Secret Manager (production on Cloud Run) - no key needed, uses Workload Identity
# Just attach the service account to your Cloud Run service:
#   gcloud run services update syrabit-backend --service-account=syrabit-backend-sa@blissful-acumen-495019-t6.iam.gserviceaccount.com

# ------------------------------------------
# P7: SARVAM AI (Assamese Brain)
# ------------------------------------------
SARVAM_API_KEY=sk_sarvam_xxx
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=openhathi-7b

# ------------------------------------------
# P8: RAZORPAY (Revenue Engine)
# ------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=secret_xxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_PLAN_ID=plan_pro_monthly
RAZORPAY_CURRENCY=INR

# ------------------------------------------
# P9: RESEND (Comms Hub)
# ------------------------------------------
RESEND_API_KEY=re_xxx
RESEND_FROM_ADDRESS=noreply@syrabit.ai
RESEND_FROM_NAME=Syrabit Education

# ------------------------------------------
# OBSERVABILITY
# ------------------------------------------
SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_API_KEY=phc_xxx
POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------
# APPLICATION LOGIC
# ------------------------------------------
APP_ENV=production
DEBUG=False
# SECURITY: You MUST change this value. The app refuses to start in production with this default.
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_AT_LEAST_32_CHARS_LONG
# Separate secret for admin JWT tokens (falls back to JWT_SECRET if not set)
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_SECRET_AT_LEAST_32_CHARS
# Separate secret for password reset tokens (falls back to JWT_SECRET if not set)
RESET_TOKEN_SECRET=CHANGE_ME_RESET_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7
ALLOWED_ORIGINS=https://syrabit.ai,https://app.syrabit.ai
MAX_CONTEXT_DOCS=5
STREAM_CHUNK_SIZE=128

# ------------------------------------------
# SEO / INDEXNOW
# ------------------------------------------
# IndexNow API key for search engine notification
INDEXNOW_API_KEY=key_xxx
# Internal secret for authenticating IndexNow webhook calls
INDEXNOW_INTERNAL_SECRET=secret_xxx
# IndexNow verification key (hosted at /{key}.txt)
INDEXNOW_KEY=key_xxx

# ------------------------------------------
# CRON / CI
# ------------------------------------------
# Secret for authenticating translation cron job requests
TRANSLATE_CRON_SECRET=secret_xxx
