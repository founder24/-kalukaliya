# ==========================================
# SYRABIT.AI - MASTER ENVIRONMENT TEMPLATE
# Copy this to .env and fill in your secrets
# DO NOT COMMIT .env TO GIT
# ==========================================

# ------------------------------------------
# 1. CLOUDFLARE (Edge & Security)
# ------------------------------------------
CLOUDFLARE_API_TOKEN=cf_api_token_here
CLOUDFLARE_ACCOUNT_ID=cf_account_id_here
CLOUDFLARE_WORKER_NAME=syrabit-edge
CLOUDFLARE_R2_BUCKET_NAME=syrabit-assets
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------
# 2. AZURE (Core Backend)
# ------------------------------------------
AZURE_SUBSCRIPTION_ID=azure_sub_id_here
AZURE_RESOURCE_GROUP=syrabit-prod
AZURE_CONTAINER_APP_NAME=syrabit-api
AZURE_REGION=eastus
AZURE_REGISTRY_URL=syrabitregistry.azurecr.io

# ------------------------------------------
# 3. MONGODB (Data & Auth)
# ------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=syrabit_prod
MONGODB_USERS_COLLECTION=users
MONGODB_CHATS_COLLECTION=chats
MONGODB_SUBSCRIPTIONS_COLLECTION=subscriptions

# ------------------------------------------
# 4. UPSTASH (Gatekeeper)
# ------------------------------------------
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your_token_here>
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10
DAILY_MESSAGE_LIMIT_FREE=30
DAILY_MESSAGE_LIMIT_PRO=1000

# ------------------------------------------
# 5. PINECONE (Intelligence)
# ------------------------------------------
PINECONE_API_KEY=pc_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=syrabit-edu-index
PINECONE_DIMENSION=768

# ------------------------------------------
# 6. VERTEX AI (English Brain)
# ------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account", ...}
VERTEX_PROJECT_ID=your-gcp-project
VERTEX_LOCATION=us-central1
VERTEX_MODEL_NAME=gemini-1.5-flash
VERTEX_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------
# 7. SARVAM AI (Assamese Brain)
# ------------------------------------------
SARVAM_API_KEY=sarvam_key_here
SARVAM_MODEL_NAME=sarvam-m-beta
SARVAM_TRANSLATION_MODEL=translate-v1

# ------------------------------------------
# 8. SENTRY (Observability)
# ------------------------------------------
SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------
# 9. POSTHOG (Analytics)
# ------------------------------------------
POSTHOG_API_KEY=phc_<key_here>
POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------
# 10. PAYMENTS (Razorpay)
# ------------------------------------------
RAZORPAY_KEY_ID=rzp_test_<key>
RAZORPAY_KEY_SECRET=<secret>
RAZORPAY_WEBHOOK_SECRET=<wh_secret>
SUBSCRIPTION_PLAN_ID_PRO=plan_pro_monthly

# ------------------------------------------
# APP SETTINGS
# ------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=super_secure_random_string_change_this_in_prod
CORS_ORIGINS=["https://syrabit.ai", "https://www.syrabit.ai"]
API_V1_PREFIX=/api/v1

# ------------------------------------------
# 11. AUTHENTICATION & JWT
# ------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_MINUTES=10080
COOKIE_DOMAIN=.syrabit.ai
COOKIE_SAMESITE=lax
SECURE_COOKIES=true
TURNSTILE_ON=true
