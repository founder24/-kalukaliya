{
  "name": "syrabit-monorepo",
  "version": "3.0.0",
  "private": true,
  "description": "Syrabit Monorepo - Edge Workers, Frontend, and Backend",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:edge": "pnpm --filter syrabit-edge run dev",
    "dev:frontend": "pnpm --filter syrabit-frontend run dev",
    "dev:api": "pnpm --filter syrabit-api run dev",
    "build:edge": "pnpm --filter syrabit-edge run build",
    "build:frontend": "pnpm --filter syrabit-frontend run build",
    "deploy:edge": "pnpm --filter syrabit-edge run deploy",
    "deploy:api": "pnpm --filter syrabit-api run deploy",
    "type-check:api": "pnpm --filter syrabit-api run type-check",
    "test": "pnpm --recursive run test"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "browserslist": "4.28.7",
      "esbuild": "0.28.1",
      "js-yaml": "4.3.2",
      "postcss-selector-parser": "6.1.3",
      "sharp": "0.35.4",
      "undici": "7.29.1",
      "brace-expansion": "1.1.21",
      "vite": "7.3.5",
      "ws": "8.21.0",
      "esbuild@<0.25.0": ">=0.25.10",
      "ws@<8.18.3": ">=8.18.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp",
      "@esbuild/linux-x64",
      "@esbuild/darwin-arm64",
      "@esbuild/darwin-x64",
      "@esbuild/win32-x64"
    ]
  },
  "dependencies": {
    "@replit/vite-plugin-cartographer": "^0.6.1",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.5"
  }
}
