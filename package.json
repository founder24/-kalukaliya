{
  "name": "syrabit-monorepo",
  "version": "3.0.0",
  "private": true,
  "description": "Syrabit Monorepo - Edge Workers, Frontend, and Backend",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:edge": "pnpm --filter syrabit-edge run dev",
    "dev:frontend": "pnpm --filter syrabit-frontend run dev",
    "dev:api": "pnpm --filter syrabit-api run dev",
    "build:edge": "pnpm --filter syrabit-edge run build",
    "build:frontend": "pnpm --filter syrabit-frontend run build",
    "deploy:edge": "pnpm --filter syrabit-edge run deploy",
    "deploy:api": "pnpm --filter syrabit-api run deploy",
    "type-check:api": "pnpm --filter syrabit-api run type-check",
    "test": "pnpm --recursive run test"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "browserslist": "4.28.7",
      "esbuild": "0.28.1",
      "postcss-selector-parser": "6.1.3",
      "sharp": "0.35.2",
      "undici": "7.29.0",
      "vite": "7.3.5",
      "ws": "8.21.0",
      "esbuild@<0.25.0": ">=0.25.10",
      "ws@<8.18.3": ">=8.18.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp",
      "@esbuild/linux-x64",
      "@esbuild/darwin-arm64",
      "@esbuild/darwin-x64",
      "@esbuild/win32-x64"
    ]
  }
}
