modules = ["python-3.12", "bash", "web", "nodejs-22"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["cargo", "freetype", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "openssl", "pkg-config", "rustc", "tcl", "tesseract", "tk", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AHSEC Ingestion"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AHSEC Fill Partial Subjects"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AHSEC Retry Blank Notes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AHSEC Bulk Seed RAG (EN)"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/syrabit run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/backend && APP_ENV=development python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
waitForPort = 8000

[[workflows.workflow]]
name = "AHSEC Bulk Seed RAG (EN)"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/backend && python3 -m scripts.bulk_seed_rag_en --parallelism 3 --delay 0.5"

[[workflows.workflow]]
name = "AHSEC Ingestion"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/backend && python3 -m scripts.ahsec_ingest --class11 --class12 --medium en --force --delay 4 && echo '=== EN INGESTION COMPLETE ==='"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "AHSEC Fill Partial Subjects"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/backend && bash scripts/ahsec_fill_gaps.sh --medium en"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "AHSEC Retry Blank Notes"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/backend && bash scripts/ahsec_retry_blank_notes.sh --medium en"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8000
externalPort = 8000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd apps/backend && pip install -r requirements.txt -q && uvicorn app.main:app --host 0.0.0.0 --port 5000"]
build = ["bash", "-c", "cd apps/frontend && pnpm install && pnpm build:client"]

[userenv]

[userenv.development]

[userenv.shared]
APP_ENV = "development"
MONGODB_DB_NAME = "syrabit_prod"
JWT_ALGORITHM = "HS256"
JWT_EXPIRY_MINUTES = "60"
REFRESH_TOKEN_EXPIRY_DAYS = "7"
RATE_LIMIT_FREE_TIER = "30"
TRUST_EDGE_AUTH = "false"
VERTEX_LOCATION = "us-central1"
VERTEX_GEMINI_MODEL = "gemini-2.5-flash"
SARVAM_BASE_URL = "https://api.sarvam.ai/v1"
RAZORPAY_PLAN_ID = "plan_pro_monthly"
RAZORPAY_CURRENCY = "INR"
RESEND_FROM_ADDRESS = "noreply@syrabit.ai"
RESEND_FROM_NAME = "Syrabit Education"
POSTHOG_HOST = "https://app.posthog.com"
ALLOWED_ORIGINS = "https://syrabit.ai,https://www.syrabit.ai,https://app.syrabit.ai,https://api.syrabit.ai,https://*.replit.dev,https://*.replit.app"
VERTEX_PROJECT_ID = "blissful-acumen-495019-t6"
VERTEX_SEARCH_DATASTORE_ID = "syrabit-edu-datastore"
VERTEX_SEARCH_LOCATION = "global"
VERTEX_SEARCH_SERVING_CONFIG = "default_search"
CLOUDFLARE_ACCOUNT_ID = "d66e40eac539fff1db270fddf384a5ec"
CLOUDFLARE_KV_NAMESPACE_ID = "981e939bcca445c481d4be818ebefee7"
SARVAM_MODEL = "sarvam-105b"
CF_R2_PUBLIC_URL = "https://pub-0af278045dba4daeb4a93fa8a348dcac.r2.dev"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
