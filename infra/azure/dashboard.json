{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "dashboardName": {
      "type": "string",
      "defaultValue": "syrabit-monitoring"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Portal/dashboards",
      "apiVersion": "2020-09-01-preview",
      "name": "[parameters('dashboardName')]",
      "location": "centralindia",
      "properties": {
        "lenses": [
          {
            "order": 0,
            "parts": [
              {
                "position": { "x": 0, "y": 0, "colSpan": 6, "rowSpan": 4 },
                "metadata": {
                  "type": "Extension/HubsExtension/PartType/MonitorChartPart",
                  "settings": {
                    "content": {
                      "options": {
                        "chart": {
                          "title": "Requests per Second",
                          "metrics": [
                            {
                              "resourceMetadata": {
                                "id": "/subscriptions/{sub}/resourceGroups/syrabit-prod/providers/Microsoft.App/containerApps/syrabit-backend"
                              },
                              "name": "Requests",
                              "aggregationType": "Count",
                              "namespace": "Microsoft.App/containerApps"
                            }
                          ],
                          "visualization": { "chartType": "Line" },
                          "timespan": { "relative": { "duration": 3600000 } }
                        }
                      }
                    }
                  }
                }
              },
              {
                "position": { "x": 6, "y": 0, "colSpan": 6, "rowSpan": 4 },
                "metadata": {
                  "type": "Extension/HubsExtension/PartType/MonitorChartPart",
                  "settings": {
                    "content": {
                      "options": {
                        "chart": {
                          "title": "Response Latency p50/p95",
                          "metrics": [
                            {
                              "resourceMetadata": {
                                "id": "/subscriptions/{sub}/resourceGroups/syrabit-prod/providers/Microsoft.App/containerApps/syrabit-backend"
                              },
                              "name": "RequestDuration",
                              "aggregationType": "Percentile",
                              "namespace": "Microsoft.App/containerApps"
                            }
                          ],
                          "visualization": { "chartType": "Line" },
                          "timespan": { "relative": { "duration": 3600000 } }
                        }
                      }
                    }
                  }
                }
              },
              {
                "position": { "x": 0, "y": 4, "colSpan": 6, "rowSpan": 4 },
                "metadata": {
                  "type": "Extension/HubsExtension/PartType/MonitorChartPart",
                  "settings": {
                    "content": {
                      "options": {
                        "chart": {
                          "title": "Error Rate by Status Code",
                          "metrics": [
                            {
                              "resourceMetadata": {
                                "id": "/subscriptions/{sub}/resourceGroups/syrabit-prod/providers/Microsoft.App/containerApps/syrabit-backend"
                              },
                              "name": "Requests",
                              "aggregationType": "Count",
                              "namespace": "Microsoft.App/containerApps"
                            }
                          ],
                          "visualization": { "chartType": "Bar" },
                          "grouping": { "dimension": "statusCode" },
                          "timespan": { "relative": { "duration": 3600000 } }
                        }
                      }
                    }
                  }
                }
              },
              {
                "position": { "x": 6, "y": 4, "colSpan": 6, "rowSpan": 4 },
                "metadata": {
                  "type": "Extension/HubsExtension/PartType/MonitorChartPart",
                  "settings": {
                    "content": {
                      "options": {
                        "chart": {
                          "title": "Container CPU & Memory Usage",
                          "metrics": [
                            {
                              "resourceMetadata": {
                                "id": "/subscriptions/{sub}/resourceGroups/syrabit-prod/providers/Microsoft.App/containerApps/syrabit-backend"
                              },
                              "name": "UsageNanoCores",
                              "aggregationType": "Average",
                              "namespace": "Microsoft.App/containerApps"
                            },
                            {
                              "resourceMetadata": {
                                "id": "/subscriptions/{sub}/resourceGroups/syrabit-prod/providers/Microsoft.App/containerApps/syrabit-backend"
                              },
                              "name": "UsageBytes",
                              "aggregationType": "Average",
                              "namespace": "Microsoft.App/containerApps"
                            }
                          ],
                          "visualization": { "chartType": "Area" },
                          "timespan": { "relative": { "duration": 3600000 } }
                        }
                      }
                    }
                  }
                }
              },
              {
                "position": { "x": 0, "y": 8, "colSpan": 12, "rowSpan": 3 },
                "metadata": {
                  "type": "Extension/HubsExtension/PartType/MonitorChartPart",
                  "settings": {
                    "content": {
                      "options": {
                        "chart": {
                          "title": "Active Revisions",
                          "metrics": [
                            {
                              "resourceMetadata": {
                                "id": "/subscriptions/{sub}/resourceGroups/syrabit-prod/providers/Microsoft.App/containerApps/syrabit-backend"
                              },
                              "name": "Replicas",
                              "aggregationType": "Average",
                              "namespace": "Microsoft.App/containerApps"
                            }
                          ],
                          "visualization": { "chartType": "Table" },
                          "grouping": { "dimension": "revisionName" },
                          "timespan": { "relative": { "duration": 3600000 } }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
