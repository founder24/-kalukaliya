VERTEX_GEMINI_MODEL=gemini-1.5-pro
VERTEX_VISION_MODEL=gemini-1.5-pro-vision

# --- P7: Sarvam AI (Indic) ---
SARVAM_API_KEY=sk_sarvam_test_key
SARVAM_BASE_URL=https://api.sarvam.ai/v1
