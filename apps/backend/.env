# --- P1: Cloudflare (Edge) ---
CF_ACCOUNT_ID=test_account_id
CF_API_TOKEN=test_api_token
CF_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
CF_R2_BUCKET=syrabit-assets
CF_WORKER_URL=https://edge.syrabit.ai

# --- P2: Azure Compute (Backend) ---
AZURE_SUBSCRIPTION_ID=test_sub_id
AZURE_RESOURCE_GROUP=rg-syrabit-prod
AZURE_CONTAINER_APP_NAME=ca-syrabit-api
AZURE_LOG_ANALYTICS_WORKSPACE=law-syrabit

# --- P3: Azure Search (Intelligence) ---
AZURE_SEARCH_ENDPOINT=https://test.search.windows.net
AZURE_SEARCH_ADMIN_KEY=test_admin_key
AZURE_SEARCH_QUERY_KEY=test_query_key
AZURE_SEARCH_INDEX_NAME=syrabit-edu-index
AZURE_SEARCH_SEMANTIC_CONFIG=default
AZURE_EMBEDDING_MODEL=text-embedding-3-large
AZURE_EMBEDDING_DIMENSIONS=1536

# --- P4: MongoDB (Data) ---
MONGODB_URI=mongodb://localhost:27017/syrabit_test
MONGODB_DB_NAME=syrabit_test
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# --- P5: Upstash (Gatekeeper) ---
UPSTASH_REDIS_REST_URL=http://localhost:6379
UPSTASH_REDIS_REST_TOKEN=test_token
RATE_LIMIT_FREE_TIER=30
RATE_LIMIT_PRO_TIER=999999

# --- P6: Vertex AI (Google) ---
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"test-project","private_key":"-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA0Z3VS5JJcds3xfn/ygWyF8PbnGy0AHB7MvXrT3cN1mJqXw==\n-----END RSA PRIVATE KEY-----\n","client_email":"test@test-project.iam.gserviceaccount.com"}
VERTEX_PROJECT_ID=test-project
