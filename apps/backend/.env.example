# --- P1: Cloudflare (Edge) ---
CF_ACCOUNT_ID=acct_xxx
CF_API_TOKEN=token_xxx
CF_R2_BUCKET=syrabit-assets
CF_R2_ACCESS_KEY=xxx
CF_R2_SECRET_KEY=xxx
CF_WORKER_URL=https://edge.syrabit.ai

# --- P2: Azure Compute (Backend) ---
AZURE_SUBSCRIPTION_ID=sub_xxx
AZURE_RESOURCE_GROUP=rg-syrabit-prod
AZURE_CONTAINER_APP_NAME=ca-syrabit-api
AZURE_LOG_ANALYTICS_WORKSPACE=law-syrabit
KEYVAULT_URL=https://syrabit-kv.vault.azure.net/

# --- P3: Azure Search (Intelligence) ---
AZURE_SEARCH_ENDPOINT=https://syrabit-search.search.windows.net
AZURE_SEARCH_ADMIN_KEY=key_xxx
AZURE_SEARCH_QUERY_KEY=query_xxx
AZURE_SEARCH_INDEX_NAME=syrabit-edu-index
AZURE_SEARCH_SEMANTIC_CONFIG=default
AZURE_EMBEDDING_MODEL=text-embedding-3-large
AZURE_EMBEDDING_DIMENSIONS=1536

# --- P4: MongoDB (Data) ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/syrabit?retryWrites=true&w=majority
MONGODB_DB_NAME=syrabit_prod
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# --- P5: Upstash (Gatekeeper) ---
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=token_xxx
RATE_LIMIT_FREE_TIER=30
RATE_LIMIT_PRO_TIER=999999

# --- P6: Vertex AI (Google) ---
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account", "project_id":"...", "private_key":"..."}
VERTEX_PROJECT_ID=proj_xxx
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-1.5-pro
VERTEX_VISION_MODEL=gemini-1.5-pro-vision

# --- P7: Sarvam AI (Indic) ---
SARVAM_API_KEY=sk_sarvam_xxx
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=openhathi-7b

# --- P8: Razorpay (Payments) ---
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=secret_xxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_PLAN_ID=plan_pro_monthly
RAZORPAY_CURRENCY=INR

# --- P9: Resend (Email) ---
RESEND_API_KEY=re_xxx
RESEND_FROM_ADDRESS=noreply@syrabit.ai
RESEND_FROM_NAME=Syrabit Education

# --- Observability ---
SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_API_KEY=phc_xxx
POSTHOG_HOST=https://app.posthog.com

# --- Application Logic ---
APP_ENV=production
DEBUG=False
JWT_SECRET=super_secret_jwt_key_32_chars_min
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7
ALLOWED_ORIGINS=https://syrabit.ai,https://app.syrabit.ai
MAX_CONTEXT_DOCS=5
STREAM_CHUNK_SIZE=128
