# ═══════════════════════════════════════════════════
# OpenTelemetry Configuration (Optional)
# ═══════════════════════════════════════════════════
#
# These are standard OTel SDK environment variables.
# Set them in your deployment environment (Container App, .env, etc.)
# If OTEL_EXPORTER_OTLP_ENDPOINT is not set, tracing is disabled.
#
# Collector endpoint (gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service identification
OTEL_SERVICE_NAME=syrabit-backend

# Sampling: trace 10% of requests in production
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Resource attributes (optional, enriches spans)
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.version=3.0.0
