# Block sensitive paths - return 404 for common attack vectors
/.env           /index.html  404
/.env.*         /index.html  404
/.git/*         /index.html  404
/.htaccess      /index.html  404
/.DS_Store      /index.html  404
/.svn/*         /index.html  404
/wp-admin       /index.html  404
/wp-login.php   /index.html  404
/server-status  /index.html  404
/phpinfo.php    /index.html  404
/web.config     /index.html  404
/wrangler.toml  /index.html  404
/package.json   /index.html  404
/tsconfig.json  /index.html  404
/Dockerfile     /index.html  404
/docker-compose.yml  /index.html  404
/.dockerignore  /index.html  404

# SPA catch-all — serve index.html for all client-side routes.
# This MUST be the last rule. Cloudflare Pages processes rules top-to-bottom
# and the first match wins. The catch-all ensures React Router handles all
# paths not matched by a static file or earlier rule.
#
# NOTE: Do NOT add trailing-slash normalization rules (e.g. /library/ -> /library 301).
# Prerendered routes have /route/index.html in the build output, so CF Pages
# asset-matches them at /route/ (via 308). A 301 back to /route creates a redirect loop.
# Let CF Pages serve the prerendered HTML directly at /route/.
/*    /index.html  200
